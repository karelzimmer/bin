# 2. sudo ~/bin/rename

# Verwerk
# Toegestane tekens in de bestandsnamen:
# host: a-z, A-Z, 0-9, -
# user: a-z, A-Z, 0-9, -, _ (let op underscore i.c.m. parameter expansion)

# *** Variatie #1 *** Hernoem van BACKUP-user@host naar BACKUP_host_user
# Voorbeeld: BACKUP-karel_zimmer@pc06 -> BACKUP_pc06_karel_zimmer
# for file in BACKUP-*; do
