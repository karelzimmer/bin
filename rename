#     echo "mv $file BACKUP_${host}_${user}"
#     # mv --verbose "$file" "BACKUP_${host}_${user}"
# done

# *** Variatie #2 *** Hernoem van BACKUP_host_user naar backup_host_user
# Voorbeeld: BACKUP_pc06_karel_zimmer -> backup_pc06_karel_zimmer
for file in BACKUP_*; do
# OLD echo + cut:
#     user_host=$(echo "$file" | cut --delimiter='_' --fields=2-3)
#     host=$(echo "$user_host" | cut --delimiter='_' --fields=1)
#     user=$(echo "$user_host" | cut --delimiter='_' --fields=2)
# NEW Parameter Expansion:
    host_user=${file#BACKUP_}
    host=${host_user%%_*}
    user=${host_user#*_}
    echo "mv $file backup_${host}_${user}"
    mv --verbose "$file" "backup_${host}_${user}"
done

# Term
exit 0
