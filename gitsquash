# #############################################################################
# Constants
# #############################################################################

# List NORMAL last here so that -x doesn't bork the display.
readonly BLUE='\033[1;34m'
readonly NORMAL='\033[0m'


# #############################################################################
# Globals
# #############################################################################

declare SEPARATOR_LINE=''


# #############################################################################
# Main
# #############################################################################

SEPARATOR_LINE=$(eval printf -- '=%.0s' '{1..79}')

clear -x

printf '%b\n' "$SEPARATOR_LINE

    Git squash merge in 9 stappen.
    Werkt het beste in twee aparte terminals door te kopiëren en te plakken.

    Het volgende dient te worden uitgevoerd ${BLUE}per repo${NORMAL}.
    Op ${BLUE}eerste machine${NORMAL}: alle stappen
    Op ${BLUE}andere machine${NORMAL}: stappen gemerkt met *

$SEPARATOR_LINE

${BLUE}Voorbereiden...${NORMAL}
 *  1.  git branch                          # noteer de samen te voegen branch
 *  2.  branch=                             # stel de naam van squash-branch in
 *  3.  git switch main                     # schakel over naar de main branch

${BLUE}Samenvoegen...${NORMAL}
    4.  git merge --squash \$branch          # voer de squash merge uit

${BLUE}Bevestigen...${NORMAL}
    5.  git commit                          # stel commit-bericht op in editor
    6.  git push origin main                # push main-branch naar de remote
    7.  git push origin --delete \$branch    # verwijder de remote branch

${BLUE}Opruimen...${NORMAL}
 *  8.  git branch --delete --force \$branch # verwijder de lokale branch
 *  9.  git pull --prune                    # verwijder verouderde verwijzingen

$SEPARATOR_LINE"
exit 0
