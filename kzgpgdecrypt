# #############################################################################
# Constants
# #############################################################################

GITROOT=$(xdg-user-dir PROJECTS 2> /dev/null || echo "$HOME")
readonly GITROOT


# #############################################################################
# Globals
# #############################################################################


# #############################################################################
# Main
# #############################################################################

gpg     --yes                                   \
        --output    "$HOME/kz-install.sh.gpg"   \
        --decrypt   "$GITROOT/kz-scripts/usr/bin/kz-install.sh.gpg"
printf  '%s\n\n'    "'$HOME/kz-install.sh.gpg' is aangemaakt"

gpg     --yes                                   \
        --output    "$HOME/kz-setup.sh.gpg"     \
        --decrypt   "$GITROOT/kz-scripts/usr/bin/kz-setup.sh.gpg"
printf  '%s\n'      "'$HOME/kz-setup.sh.gpg' is aangemaakt"

printf  '\n%s\n%s\n'    \
        "Use \"kzgpgsign\" to sign the kz GPG files."   \
        "Use \"kzgpgdelete\" to delete the decrypted kz GPG files."
