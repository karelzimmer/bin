mkdir --parents ~/.local/share/man/man1
cp ~/bin/mang.1 ~/.local/share/man/man1
mandb --user-db 1> /dev/null

usage() {
    cat <<EOF
Gebruik: ${0##*/} [SECTIE] PAGINA
         ${0##*/} 'PAGINA(SECTIE)'

Open een man-pagina in Yelp (GNOME Help).

Opties:
  -h, --help    Toon deze hulptekst en sluit af

Voorbeelden:
  ${0##*/} printf
  ${0##*/} 3 printf
  ${0##*/} 'printf(3)'
EOF
}

case "$1" in
    -h | --h | --he | --hel | --help )
        usage
        exit 0
        ;;
    -* )
        printf "%s\n" "${0##*/}: ongeldige optie -- '$1'" >&2
        usage >&2
        exit 1
        ;;
esac

if [[ $# -eq 1 ]]; then
    # Extract page and section from the format 'PAGINA(SECTIE)'.
    # This approach uses a regular expression match to extract the page and
    # section into BASH_REMATCH.
    # if [[ "$1" =~ ^([^(]+)\(([^)]+)\)$ ]]; then
    #     page="${BASH_REMATCH[1]}"
    #     section="${BASH_REMATCH[2]}"
    # This approach uses Bash parameter expansion.
    if [[ "$1" == *\(*\) ]]; then
        page=${1%%(*}
        section=${1#*(}
        section=${section%)}
    else
        page=$1
        section=''
    fi
elif [[ $# -eq 2 ]]; then
    section=$1
    page=$2
else
    usage >&2
    exit 1
fi

if ! man -w ${section:+$section} "$page" &> /dev/null; then
    printf  '%s\n' \
            "Er is geen pagina over $page${section:+ in sectie $section}" >&2
    exit 1
fi

yelp "man:$page($section)" &> /dev/null &
