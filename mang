if [[ $# -lt 1 || $# -gt 2 ]]; then
    echo "Usage: ${0##*/} PAGE [SECTION]" >&2
    exit 1
fi

if ! man -w ${2:+$2} "$1" &> /dev/null; then
    echo "No man page found for '$1'${2:+ in section $2}." >&2
    exit 1
fi

yelp "man:$1($2)" 2> /dev/null &