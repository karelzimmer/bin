usage() {
    cat <<EOF
Gebruik: ${0##*/} [SECTIE] PAGINA
         ${0##*/} 'PAGINA(SECTIE)'

Open een man-pagina in Yelp (GNOME Help).

Opties:
  -h, --help    toon deze hulptekst en sluit af

Voorbeelden:
  ${0##*/} printf
  ${0##*/} 3 printf
  ${0##*/} 'printf(3)'
EOF
}

case "$1" in
    -h | --h | --he | --hel | --help )
        usage
        exit 0
        ;;
    -* )
        echo "${0##*/}: ongeldige optie '$1'" >&2
        echo "Typ '${0##*/} --help' voor meer informatie." >&2
        exit 1
        ;;
esac

if [[ $# -eq 1 ]]; then
    if [[ "$1" == *\(*\) ]]; then
        page=${1%%(*}
        section=${1#*(}
        section=${section%)}
    else
        page=$1
        section=''
    fi
elif [[ $# -eq 2 ]]; then
    section=$1
    page=$2
else
    usage >&2
    exit 1
fi

if ! man -w ${section:+$section} "$page" &> /dev/null; then
    echo "Geen man-pagina gevonden voor '$page'${section:+ in sectie \
$section}." >&2
    exit 1
fi

yelp "man:$page($section)" &> /dev/null &
